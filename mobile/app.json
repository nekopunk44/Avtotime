{
  "expo": {
    "name": "Avtotime",
    "slug": "avtotime",
    "version": "1.0.0",
    "scheme": "avtotime",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.avtotime.app"
    },
    "android": {
      "package": "org.avtotime.app",
      "backgroundColor": "#0B0B0E",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Приложению нужен доступ к микрофону для записи голосовых сообщений."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#111111"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID используется для быстрой разблокировки приложения."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0B"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "googleWebClientId": "602150943944-45oom92dmun40ae6qhk1iepc05la8ahd.apps.googleusercontent.com",
      "googleAndroidClientId": "602150943944-dtkv9od8gidpnh0di64g6bjs7omobluv.apps.googleusercontent.com",
      "eas": {
        "projectId": "1b236563-82b2-4dc0-a347-c211f3bd7603"
      }
    },
    "owner": "nekopunk"
  }
}
