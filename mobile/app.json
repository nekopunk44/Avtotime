{
  "expo": {
    "name": "Avtotime",
    "slug": "avtotime",
    "version": "1.0.0",
    "scheme": "avtotime",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.avtotime.app"
    },
    "android": {
      "package": "org.avtotime.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Приложению нужен доступ к микрофону для записи голосовых сообщений."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "googleWebClientId": "602150943944-45oom92dmun40ae6qhk1iepc05la8ahd.apps.googleusercontent.com",
      "eas": {
        "projectId": "1b236563-82b2-4dc0-a347-c211f3bd7603"
      }
    },
    "owner": "nekopunk"
  }
}
