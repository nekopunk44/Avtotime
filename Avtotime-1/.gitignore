# Backend
backend/node_modules
backend/.env
backend/.env.*
backend/public
backend/.mongo-data*
backend/.mongo-binaries
backend/.mongo-tmp

# Frontend
frontend/node_modules
frontend/dist
frontend/dist-ssr
frontend/.env
frontend/.env.*

# Production secrets — never commit, fill values on the server
.env.production
.env.production.local
*.local

# SSL certificates — generated by Certbot/Let's Encrypt on the server
nginx/certs/

# Logs
**/*.log
*.out.log
*.err.log
