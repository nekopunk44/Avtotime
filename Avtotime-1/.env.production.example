# ═══════════════════════════════════════════════════════════════════════════
#  AVTOTIME — Production environment template
#
#  1. Скопируй этот файл на сервер:  cp .env.production.example .env.production
#  2. Заполни все значения, помеченные  ← ЗАПОЛНИТЬ
#  3. Запусти:  bash scripts/init-ssl.sh yourdomain.com your@email.com
# ═══════════════════════════════════════════════════════════════════════════

# Сервер
NODE_ENV=production
PORT=8000
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb

# CORS
# Домен фронтенда — что видит пользователь в браузере
CLIENT_ORIGINS=https://yourdomain.com        # ← ЗАПОЛНИТЬ
CLIENT_URL=https://yourdomain.com            # ← ЗАПОЛНИТЬ (используется в письмах)

# JWT / Cookie
JWT_SECRET=                                  # ← ЗАПОЛНИТЬ (минимум 32 случайных символа)
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_SAMESITE=None

# MongoDB
# docker-compose подставляет mongodb://mongodb:27017/avtotime автоматически.
# Раскомментируй и заполни только если используешь внешний кластер (Atlas и т.п.):
# MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/avtotime

# Email / OTP (сброс пароля)
EMAIL=                                       # ← ЗАПОЛНИТЬ (Gmail-адрес)
EMAIL_PASS=                                  # ← ЗАПОЛНИТЬ (Gmail App Password)

# Cloudinary (загрузка изображений)
# Бесплатный тариф: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=                       # ← ЗАПОЛНИТЬ
CLOUDINARY_API_KEY=                          # ← ЗАПОЛНИТЬ
CLOUDINARY_API_SECRET=                       # ← ЗАПОЛНИТЬ

# Google OAuth
GOOGLE_CLIENT_ID=                            # ← ЗАПОЛНИТЬ (console.cloud.google.com)

# Stripe (платежи)
# Получи ключи на: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...               # ← ЗАПОЛНИТЬ
STRIPE_PUBLISHABLE_KEY=pk_live_...          # ← ЗАПОЛНИТЬ
STRIPE_WEBHOOK_SECRET=whsec_...             # ← ЗАПОЛНИТЬ

# Администратор
ADMIN_USERNAMES=                             # ← ЗАПОЛНИТЬ (напр. admin)
ADMIN_EMAILS=                                # ← ЗАПОЛНИТЬ (напр. admin@yourdomain.com)
ADMIN_USER_IDS=                              # не обязательно

# Redis (горизонтальное масштабирование)
# docker-compose подставляет redis://redis:6379 автоматически.
# Раскомментируй для внешнего Redis:
# REDIS_URL=redis://:password@your-redis-host:6379
REDIS_SOCKET_ADAPTER_ENABLED=true

# Кластеризация (Node.js cluster)
# По умолчанию — по числу CPU ядер. Можно зафиксировать вручную.
# CLUSTER_WORKERS=4

# Кэш ответов
MARKET_LIST_CACHE_TTL_MS=30000
RESPONSE_CACHE_TTL_MS=15000

# Rate limiting
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_15_MIN=20

# AI-модерация
AI_MODERATION_ENABLED=false
AI_MODERATION_PROVIDER=local
# Включить облачную модерацию через OpenAI:
# AI_MODERATION_ENABLED=true
# AI_MODERATION_PROVIDER=openai
# OPENAI_API_KEY=sk-...
