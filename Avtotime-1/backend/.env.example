### Database
MONGODB_URL=mongodb://localhost:27017/avtotime
# Alternative (preferred for production): mount secret file and set path
MONGODB_URL_FILE=
# Connection pool — increase for high traffic (default 50)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10

### Server
PORT=8000
NODE_ENV=development

### CORS
# Comma-separated list of allowed frontend origins (no "*" when credentials=true).
# Example: https://your-frontend.com,https://www.your-frontend.com
CLIENT_ORIGINS=

### Redis / multi-instance sockets
# Enable for horizontal scaling (shared Socket.IO presence/events across backend instances)
REDIS_URL=
REDIS_SOCKET_ADAPTER_ENABLED=true

### Shared market list cache
# TTL in milliseconds; when REDIS_URL is set this cache is shared across backend replicas.
MARKET_LIST_CACHE_TTL_MS=5000
# Max in-memory LRU entries per worker (prevents OOM)
MARKET_LIST_CACHE_MAX_ENTRIES=2000

### Generic response cache
# Used for lightweight repeated reads like notifications count and market metadata.
RESPONSE_CACHE_TTL_MS=10000
# Max in-memory LRU entries per worker (prevents OOM)
RESPONSE_CACHE_MAX_ENTRIES=5000

### Auth session cache (Redis)
# Seconds to cache tokenVersion + isBanned per user (reduces DB queries per request)
AUTH_CACHE_TTL_SECONDS=60

### Auth
# Dev-only placeholder — ОБЯЗАТЕЛЬНО замени на случайную строку в production
JWT_SECRET=dev-only-insecure-secret-change-before-deploy
JWT_SECRET_FILE=
JWT_EXPIRES_IN=7d

### Field encryption at rest (optional but recommended for prod)
# AES-256-GCM key (32 bytes). Prefer base64 or hex.
APP_ENC_KEY=
APP_ENC_KEY_FILE=
FIELD_ENCRYPTION_ENABLED=false

### Cookies
# For separate domains in production you usually need: COOKIE_SAMESITE=None and COOKIE_SECURE=true
COOKIE_SAMESITE=
COOKIE_SECURE=

### Frontend URL (used in email links)
CLIENT_URL=http://localhost:5173

### Email (password reset OTP + email verification)
EMAIL=
EMAIL_PASS=

### In-memory MongoDB (dev only)
# If MONGODB_URL is not set, backend starts mongodb-memory-server.
# By default it persists data to ./backend/.mongo-data so users won't disappear after restart.
MONGO_MEMORY_PERSIST=true
MONGO_MEMORY_DB_PATH=.mongo-data
# Optional: pin the port so you can connect from MongoDB Compass / VS Code extension
# (e.g. 27018 to avoid conflicts with a local MongoDB on 27017).
MONGO_MEMORY_PORT=

### Google OAuth
# Получи Client ID на: https://console.cloud.google.com/apis/credentials
# Тип: "OAuth 2.0 Client ID" → "Web application"
# Добавь в "Authorized JavaScript origins": http://localhost:5173 (и свой домен в production)
GOOGLE_CLIENT_ID=

### Stripe (payments)
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get webhook secret by running: stripe listen --forward-to localhost:8000/api/payment/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

### Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

### AI moderation (text + images -> pending -> approve/reject)
# Enable moderation worker + create listings as "pending"
AI_MODERATION_ENABLED=false

# Provider: "local" (no API costs) or "openai"
AI_MODERATION_PROVIDER=local

# OpenAI
OPENAI_API_KEY=
# Optional overrides
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Worker tuning
AI_MODERATION_WORKER_INTERVAL_MS=15000
AI_MODERATION_BATCH_PER_MODEL=5
AI_MODERATION_MAX_IMAGES=5

# Local image moderation (nsfwjs)
# Optional: host model files locally (recommended if using tfjs-node + file:// loading).
# Model dir can be generated with: npm run download:nsfw-model
AI_MODERATION_NSFWJS_MODEL_DIR=./moderation/models/nsfwjs
AI_MODERATION_LOCAL_IMAGE_REQUIRED=true

# Profile avatar moderation (18+)
AI_PROFILE_IMAGE_MODERATION_ENABLED=true
AI_MODERATION_IMAGE_FETCH_TIMEOUT_MS=10000
AI_MODERATION_MAX_IMAGE_BYTES=5000000
AI_MODERATION_NSFW_PORN_THRESHOLD=0.8
AI_MODERATION_NSFW_HENTAI_THRESHOLD=0.8
AI_MODERATION_NSFW_SEXY_THRESHOLD=0.9

# If moderation keeps failing, stop retrying after N attempts
AI_MODERATION_MAX_ATTEMPTS=10
AI_MODERATION_MAX_ATTEMPTS_ACTION=approve

# Optional: comma-separated banned words
AI_MODERATION_BANNED_WORDS=
# If true, any text finding flags the post (otherwise text findings are only reasons, and images decide)
AI_MODERATION_TEXT_STRICT=false
